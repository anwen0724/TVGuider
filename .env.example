# Copy this template to .env and fill in keys only for the providers you use.
# Commit this template; keep real credentials in the Git-ignored .env file.
# Existing system environment variables take precedence over .env values.
# Model names and generation parameters are configured in the client config classes.

# DeepSeek: https://api-docs.deepseek.com/zh-cn/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen: Beijing endpoint; use an API key from the matching region.
# https://help.aliyun.com/en/model-studio/model-calling-in-sub-workspace
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI: uncomment BASE_URL only when overriding the SDK default endpoint.
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Claude: uncomment BASE_URL only when overriding the SDK default endpoint.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# CodeLlama: the default client uses Together AI.
# Change base_url/model in CodeLlamaClientConfig when using another provider.
CODELLAMA_API_KEY=
